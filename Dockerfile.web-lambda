FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
COPY src/main ./src/main
RUN mvn -B -ntp -Dmaven.test.skip=true package dependency:copy-dependencies \
    -DincludeScope=runtime -DoutputDirectory=target/lambda-libs

FROM public.ecr.aws/lambda/java:21
COPY --from=build /build/target/classes/ ${LAMBDA_TASK_ROOT}/
COPY --from=build /build/target/lambda-libs/ ${LAMBDA_TASK_ROOT}/lib/
CMD ["com.dailybrief.WebLambdaHandler::handleRequest"]
